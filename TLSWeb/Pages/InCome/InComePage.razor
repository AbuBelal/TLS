@using SharedLib.Mapper
@attribute [Route(PagesUris.InComePages.Manage)]
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
        <h3 class="mb-0">
            <i class="bi bi-cash-coin me-2 text-success"></i>
            إدارة الواردات
        </h3>
        <AuthorizeView Roles="@AppRoles.Admin">
            <div class="d-flex gap-2" dir="rtl">
                <button class="btn btn-success shadow-sm" @onclick="OpenAddPage">
                    <i class="bi bi-plus-circle me-1"></i> إضافة وارد
                </button>

                <button class="btn btn-success shadow-sm d-flex align-items-center gap-2"
                        @onclick="ExportTotals"
                        disabled="@(isExporting)">
                    @if (isExporting)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>جاري التصدير...</span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-excel-fill"></i>
                        <span>تصدير أرصدة المراكز Excel</span>
                    }
                </button>
            </div>
        </AuthorizeView>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">جاري التحميل...</span>
            </div>
            <p class="mt-2 text-muted">جاري تحميل البيانات...</p>
        </div>
    }
    else if (!incomes.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-cash fs-1 d-block mb-2"></i>
            <p class="fs-5 fw-semibold">لا توجد بيانات للعرض</p>
            <p class="small">جرب إضافة وارد جديد</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 fs-6">
                        <i class="bi bi-clipboard-data me-1"></i> عدد الوارد: <strong>@totalCount</strong>
                    </span>
                    <span class="badge bg-info bg-opacity-10 text-success px-3 py-2 fs-6">
                        <i class="bi bi-box-seam me-1"></i> الكمية الإجمالية: <strong>@totalAmount.ToString("N0")</strong>
                    </span>
                </div>

                <!-- شريط البحث والفلترة -->
                <div class="row mb-3 g-2 bg-light p-2 rounded border-light shadow-sm mx-0">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>

                            <!-- إضافة list="itemsDatalist" لربط الحقل بالقائمة -->
                            <input type="text"
                                   class="form-control"
                                   list="itemsDatalist"
                                   placeholder="بحث بالصنف / الاسم..."
                                   @bind="SearchItem" />

                            <!-- إنشاء القائمة المخفية التي ستظهر كخيارات للإكمال التلقائي -->
                            <datalist id="itemsDatalist">
                                @if (AllItems != null)
                                {
                                    @foreach (var item in AllItems)
                                    {
                                        <!-- افترضت أن اسم الصنف مخزن في خاصية Name، يمكنك تغييرها حسب الكلاس لديك -->
                                        <option value="@item"></option>
                                    }
                                }
                            </datalist>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-shop text-muted"></i></span>
                            <select class="form-select" @bind="SearchCenter">
                                <option value="">-- جميع المراكز --</option>
                                @if (AllCenters != null)
                                {
                                    @foreach (var center in AllCenters)
                                    {
                                        <option value="@center">@center</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    @* <div class="col-md-4 d-flex align-items-center">
                        <small class="text-muted ms-2">
                            * يتم الفلترة تلقائياً عند الانتهاء من الكتابة (النقر خارج الحقل أو Enter)
                        </small>
                    </div> *@
                </div>
            </div>

            @if (!filteredIncomes.Any())
            {
                <div class="alert alert-warning m-3 text-center" role="alert">
                    لا توجد نتائج مطابقة لبحثك.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>اسم الوارد</th>
                                <th>الصنف / الكمية</th>
                                <th>التاريخ</th>
                                <th>المركز</th>
                                <th>المستلم</th>
                                <AuthorizeView Roles="Admin">
                                    <th style="width: 200px;" class="text-center">إجراءات</th>
                                </AuthorizeView>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var row = 0;
                            }
                            @foreach (var income in pagedIncomes)
                            {
                                row++;
                                <tr>
                                    <td class="text-muted small">@(((currentPage - 1) * pageSize) + row)</td>
                                    <td>
                                        <div class="fw-semibold">@income.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(income.Comments))
                                        {
                                            <small class="text-muted">@income.Comments</small>
                                        }
                                    </td>
                                    @if (income.Qnty < 0)
                                    {
                                        <td><span class="badge bg-danger bg-opacity-10 text-danger fw-bold fs-5">@income.Qnty.ToString("N0")</span></td>
                                    }
                                    else
                                    {
                                        <td><span class="badge bg-success bg-opacity-10 text-success fw-bold fs-5">@income.Qnty.ToString("N0")</span></td>
                                    }
                                    <td>@income.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@income.CenterName</td>
                                    <td>@(string.IsNullOrEmpty(income.RecipientName) ? "-" : income.RecipientName)</td>
                                    <AuthorizeView Roles="Admin">
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="@(() => OpenEditPage(income.Id))" title="تعديل">
                                                    <i class="bi bi-pencil-square"></i> تعديل
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="@(() => ConfirmDelete(income))" title="حذف">
                                                    <i class="bi bi-trash"></i> حذف
                                                </button>
                                            </div>
                                        </td>
                                    </AuthorizeView>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <div class="card shadow-sm border-0 mb-4 mt-2">
                        <div class="card-body py-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">
                                    عرض @(((currentPage - 1) * pageSize) + 1)
                                    إلى @(Math.Min(currentPage * pageSize, totalCount))
                                    من أصل @totalCount
                                </span>
                                <nav>
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="@(() => GoToPageAsync(1))">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </button>
                                        </li>
                                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                            <button class="page-link" @onclick="@(() => GoToPageAsync(currentPage - 1))">
                                                <i class="bi bi-chevron-right"></i>
                                            </button>
                                        </li>

                                        @foreach (var pageNo in GetPageNumbers())
                                        {
                                            <li class="page-item @(pageNo == currentPage ? "active" : "")">
                                                <button class="page-link" @onclick="@(() => GoToPageAsync(pageNo))"> @pageNo </button>
                                            </li>
                                        }

                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="@(() => GoToPageAsync(currentPage + 1))">
                                                <i class="bi bi-chevron-left"></i>
                                            </button>
                                        </li>
                                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                            <button class="page-link" @onclick="@(() => GoToPageAsync(totalPages))">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </button>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@if (showDeleteModal && incomeToDelete is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title">تأكيد الحذف</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">
                        هل أنت متأكد من حذف الإيراد <strong>@incomeToDelete.Name</strong>؟
                    </p>
                    <p class="text-muted small">الكمية: @incomeToDelete.Qnty.ToString("N0")</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" @onclick="CancelDelete" disabled="@isDeleting">إلغاء</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteConfirmedAsync" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        حذف
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="financial-summary-container" dir="rtl">
    <!-- بطاقة إجمالي الوارد -->
    <div class="summary-card card-received">
        <div class="card-icon">⬇️</div>
        <div class="card-info">
            <span class="card-title">إجمالي الوارد</span>
            <h3 class="card-value">@TotalReceived</h3>
        </div>
    </div>

    <!-- بطاقة إجمالي المصروف / الموزع -->
    <div class="summary-card card-distributed">
        <div class="card-icon">⬆️</div>
        <div class="card-info">
            <span class="card-title">إجمالي الموزع</span>
            <h3 class="card-value">@TotalDist</h3>
        </div>
    </div>

    <!-- بطاقة المتبقي / الفرق -->
    <div class="summary-card card-balance">
        <div class="card-icon">📊</div>
        <div class="card-info">
            <span class="card-title">الرصيد الحالي (الفرق)</span>
            <h3 class="card-value">@(TotalReceived - TotalDist)</h3>
        </div>
    </div>
</div>


@code
{
    private List<InComeDto> incomes = new();
    private List<InComeDto> filteredIncomes = new(); // قائمة الداتا بعد الفلترة
    private List<InComeDto> pagedIncomes = new();
    private InComeDto? incomeToDelete;
    private bool isLoading = true;
    private bool isExporting = false;
    private bool isDeleting = false;
    private bool showDeleteModal = false;
    private List<string> AllCenters;
    private List<string> AllItems;


    // خصائص البحث مع تفعيل تحديث الفلترة التلقائي
    private string _searchItem = string.Empty;
    private string SearchItem
    {
        get => _searchItem;
        set
        {
            _searchItem = value;
            ApplyFilters();
        }
    }

    private string _searchCenter = string.Empty;
    private string SearchCenter
    {
        get => _searchCenter;
        set
        {
            _searchCenter = value;
            ApplyFilters();
        }
    }

    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages = 0;
    private decimal totalAmount = 0;
    private decimal TotalDist = 0;
    private decimal TotalReceived = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadIncomesAsync();
        var Centers = await InComeApi.GetAll();
        AllCenters = Centers.Select(c => c.CenterName).Distinct().ToList();

        var Items = await InComeApi.GetAll();
        AllItems = Items.Select(i => i.Name).Distinct().ToList();
    }

    private async Task LoadIncomesAsync()
    {
        var authState = await authenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        isLoading = true;
        try
        {
            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                if (user.IsInRole("Admin"))
                {
                    incomes = await InComeApi.GetAll();
                    TotalReceived = await InComeApi.GetBuildingTotal(null);
                    TotalDist = await DailyReportApi.GetBuildingTotalDist(null);
                }
                else
                {
                    incomes = await InComeApi.GetByCenter(0);
                    var BuildingCode = incomes.FirstOrDefault()?.BuildingCode;
                    if (BuildingCode is not null)
                    {
                        TotalReceived = await InComeApi.GetBuildingTotal(BuildingCode);
                        TotalDist = await DailyReportApi.GetBuildingTotalDist(BuildingCode);
                    }
                }
            }

            if (incomes is not null)
            {
                // تهيئة الفلتر للمرة الأولى (يعادل عرض كل البيانات)
                ApplyFilters();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading incomes: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    // دالة تطبيق الفلترة
    private void ApplyFilters()
    {
        if (incomes == null) return;

        var query = incomes.AsEnumerable();

        // 1. فلترة بالصنف (استخدمت الاسم Name، غيرها إلى ItemName مثلاً إن اختلفت عندك)
        if (!string.IsNullOrWhiteSpace(SearchItem))
        {
            query = query.Where(i => i.Name != null && i.Name.Contains(SearchItem, StringComparison.OrdinalIgnoreCase));
        }

        // 2. فلترة بالمركز
        if (!string.IsNullOrWhiteSpace(SearchCenter))
        {
            query = query.Where(i => i.CenterName != null && i.CenterName.Contains(SearchCenter, StringComparison.OrdinalIgnoreCase));
        }

        filteredIncomes = query.ToList();

        // 3. تحديث الإحصائيات لتشمل الداتا المفلترة فقط
        totalCount = filteredIncomes.Count;
        totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
        totalAmount = filteredIncomes.Sum(i => i.Qnty);

        // 4. تصفير الصفحة للرقم 1 عند البحث
        currentPage = 1;

        UpdatePagedIncomes();
    }

    private void UpdatePagedIncomes()
    {
        // سحب البيانات من القائمة المفلترة وليس الأساسية
        pagedIncomes = filteredIncomes
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void OpenAddPage()
    {
        NavManager.NavigateTo(PagesUris.InComePages.Add);
    }

    private void OpenEditPage(long id)
    {
        NavManager.NavigateTo(PagesUris.InComePages.Edit + $"/{id}");
    }

    private void ConfirmDelete(InComeDto income)
    {
        incomeToDelete = income;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        incomeToDelete = null;
    }

    private async Task DeleteConfirmedAsync()
    {
        if (incomeToDelete is null) return;

        isDeleting = true;
        try
        {
            var result = await InComeApi.Delete(incomeToDelete.Id);
            if (result.Success)
            {
                await LoadIncomesAsync();
                showDeleteModal = false;
                incomeToDelete = null;
                MudSnackbar.Add("تمت عملية الحذف ", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting income: {ex.Message}");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        int start = Math.Max(1, currentPage - 2);
        int end = Math.Min(totalPages, currentPage + 2);

        for (int i = start; i <= end; i++)
        {
            pages.Add(i);
        }
        return pages;
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;
        currentPage = page;
        UpdatePagedIncomes();
    }

    private async Task ExportTotals()
    {
        if (isExporting) return;
        isExporting = true;
        try
        {
            var response = await InComeApi.ExportIncomeBalance();
            if (response.IsSuccessStatusCode)
                await ExcelDownloader.DownloadFromResponse(response, "تقرير_أرصدة_المراكز.xlsx");
            else
                MudSnackbar.Add("فشل تصدير الملف", Severity.Error);
        }
        catch (Exception ex)
        {
            MudSnackbar.Add($"خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}
