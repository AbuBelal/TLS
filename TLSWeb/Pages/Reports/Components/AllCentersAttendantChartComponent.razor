@using MudBlazor


<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" GutterBottom="true">تحليل نسبة الحضور اليومي للمراكز</MudText>
    <MudText Typo="Typo.h6" GutterBottom="true">@DaysOfWeek</MudText>

    <MudChart ChartType="ChartType.Line"
              ChartSeries="@Series"
              ChartLabels="@Labels"
              Width="100%"
              Height="400px"
              ChartOptions="@_options" />
</MudPaper>

@code {
    [Parameter] public string DaysOfWeek { get; set; } = "الأحد-الثلاثاء-الخميس"; //  أيام العمل الافتراضية
    private LineChartOptions _options = new LineChartOptions()
    {
        XAxisTitle = "الزمن",
        YAxisTitle = "نسبة الحضور",

    };
    private string[] Labels;
    private List<ChartSeries<double>> Series = new List<ChartSeries<double>>();
    public Dictionary<string, List<double>> CenterAttendanceData = new Dictionary<string, List<double>>(); // لتخزين بيانات الحضور لكل مركز
    // لنفترض أن هذه هي القائمة التي أرفقتها في سؤالك
    public List<AllCentersDailyAttendance> RawData { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DateOnly from =DateOnly.FromDateTime( DateTime.Today.AddDays(-15));
        DateOnly to = DateOnly.FromDateTime(DateTime.Today);

        var request = new AttendanceRequest()
        {
            CenterId = 0,
            From = from,
            To = to,
            DaysOfWeek = DaysOfWeek
        };
        RawData =await AttendanceApi.GetAttendancesAllCentersAvg(request); // تأكد من أن هذه الطريقة تعيد البيانات بشكل صحيح
        PrepareChartData(RawData);
    }

    private void PrepareChartData(List<AllCentersDailyAttendance> RawData)
    {
        if (RawData == null || !RawData.Any()) return;

        // 1. تحضير التسميات للمحور الأفقي (التواريخ)
        Labels = RawData.OrderBy(x => x.Order)
                        .Select(x => x.Date.ToString("dd/MM"))
                        .ToArray();
        string AreaLable = "متوسط المنطقة العام";
        foreach (var data in RawData)
        {
            //add area percentage
            var areaPercentData = data.AreaAttendanceAvg;
            AddToDic(AreaLable, areaPercentData);
            string CenterName = "";
            foreach (var center in data.CentersAttendance)
            {
                if (center.DaysOfWeek!=DaysOfWeek) continue;

                CenterName = center.CenterName;
                var centerData = center.CenterAttendanceAvg;
                AddToDic(CenterName, centerData);
            }

        }

        foreach (var entry in CenterAttendanceData)
        {
            Series.Add(new ChartSeries<double>
            {
                Name = entry.Key,
                Data = entry.Value.ToArray()
            });
        }
    }

    private void AddToDic(string centerName, double centerData)
    {
        if (CenterAttendanceData.ContainsKey(centerName))
        {
            CenterAttendanceData[centerName].Add(centerData);
        }
        else
        {
            CenterAttendanceData[centerName] = new List<double> { centerData };
        }
    }
}