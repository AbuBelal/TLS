@using TLSWeb.Components
@using TLSWeb.Pages.Reports.Components
@attribute [Route(PagesUris.ReportsPages.AllCentersAttendantChart)]
@if (DaysOfWeek is null || DaysOfWeek.Count <= 0)
{
    <LoadingComponent></LoadingComponent>
}
else
{
    @foreach (var day in DaysOfWeek)
    {
        <AllCentersAttendantChartComponent DaysOfWeek="@day"></AllCentersAttendantChartComponent>
    }
}



@code {
    List<string?> DaysOfWeek = new List<string>();
    protected override async Task OnInitializedAsync()
    {
        DaysOfWeek = await CenterApi.GetDaysOfWorks();
    }
}
