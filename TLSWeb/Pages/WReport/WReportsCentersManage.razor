@attribute [Route(PagesUris.WReportsPages.CentersManage+"/{WRId:long}")]

@using SharedLib.Entities
@using TLSWeb.Components

<div class="container my-4" dir="rtl">
    <!-- Header & Action Button -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-primary mb-1">📋  مجموعات التقارير الأسبوعية للمراكز</h3>
                <p class="text-muted mb-0">إدارة وعرض مجموعات التقرير الأسبوعي للمراكز </p>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (centers == null)
            {
                <div class="text-center my-5 py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                    <p class="mt-2 text-muted">جاري تحميل التقارير...</p>
                </div>
            }
            else if (!centers.Any())
            {
                <div class="text-center my-5 py-5">
                    <i class="bi bi-inbox text-muted display-4"></i>
                    <p class="mt-3 text-muted fw-bold">لا توجد تقارير أسبوعية مضافة حتى الآن.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>اسم المركز</th>
                                <th>أدخل التقرير</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in centers)
                            {
                                <tr>
                                    <td class="fw-bold">@item.SortOrder</td>
                                    <td>
                                        @item.Name 
                                    </td>
                                    <td>
                                        @{
                                            // حساب النسبة مرة واحدة
                                            var progress = CalcReportProgress(WRId, item.Id);

                                            // التحقق من وجود التقرير
                                            var isSubmitted = reports.Any(r => r.CenterId == item.Id && r.WReportId == WRId);

                                            // تحديد لون شريط التقدم بناءً على النسبة
                                            string barColor = progress switch
                                            {
                                                100 => "bg-success", // أخضر للاكتمل
                                                >= 50 => "bg-info",  // أزرق فوق النصف
                                                > 0 => "bg-warning", // أصفر للبدايات
                                                _ => "bg-danger"     // أحمر للصفر
                                            };
                                        }

                                        <div class="d-flex align-items-center gap-2" style="min-width: 150px;">
                                            <!-- أيقونة الحالة -->
                                            @if (isSubmitted)
                                            {
                                                <i class="bi bi-check-circle-fill text-success fs-5" title="تم إدخال التقرير"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-danger fs-5" title="لم يتم الإدخال بعد"></i>
                                            }

                                            <!-- شريط التقدم -->
                                            <div class="progress flex-grow-1" style="height: 18px; background-color: #e9ecef; border-radius: 6px;">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated @barColor"
                                                     role="progressbar"
                                                     style="width: @(progress)%; font-size: 11px; font-weight: bold; line-height: 18px;"
                                                     aria-valuenow="@progress"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                    @progress%
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                  @*   <td>
                                        @((MarkupString)((reports.Where(r => r.CenterId == item.Id && r.WReportId == WRId).FirstOrDefault()?.Id ?? 0) == 0 ?
                                         "<Span> <i class= \"bi bi-x-circle-fill text-danger\" > </i> </span>"
                                        :"<span> <i class= \"bi bi-check-circle-fill text-success\" ></i>  </span>"))
                                    
                                        <span class="ms-2">
                                            @CalcReportProgress(WRId,item.Id) %
                                        </span>
                                    </td> *@
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- View -->
                                            @* <button class="btn btn-sm btn-outline-info" title="عرض" @onclick="() => OpenViewModal(item)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            &nbsp;&nbsp; *@
                                            
                                            <!-- Manage Details Component -->
                                                <button class="btn btn-sm btn-outline-primary" title="إدخال تفاصيل الأنشطة" @onclick="() => 
                                                    NavigateToEdit(reports.Where(r=>r.CenterId==item.Id && r.WReportId==WRId).FirstOrDefault()?.Id??0,item.Id)">
                                                <i class="bi bi-list-check"></i> التفاصيل
                                            </button>
                                            &nbsp;&nbsp;

                                           
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public long WRId { get; set; }
    private List<WReportDetail>? reports;
    private List<Center>? centers;
    private WReport activeReport = new();

    private enum ModalMode { Create, Edit, View }

    protected override async Task OnInitializedAsync()
    {
        centers = await CenterApi.GetAll();
        centers = centers.Where(x=>x.IsActive).OrderBy(c => c.SortOrder).ToList();
        await LoadReports();
    }

    private async Task LoadReports()
    {
        try
        {
            reports = await WReportDetailsApi.GetAll();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reports: {ex.Message}");
            reports = new List<WReportDetail>();
        }
    }

    private int CalcReportProgress(long reportId, long centerId)
    {
        float ProgressPercentage = 0f;
        float allFieldsCount = 50;

        var existingDetail = reports?.FirstOrDefault(r => r.WReportId == reportId && r.CenterId == centerId);

        if (existingDetail != null)
        {

            ProgressPercentage += existingDetail.SubmissionDate is null ?0:1;
            ProgressPercentage += existingDetail.OverallImplementation is null ?0:1;
            ProgressPercentage += existingDetail.EducationalAchievement is null ?0:1;
            ProgressPercentage += existingDetail.PsychosocialAchievement is null ?0:1;
            ProgressPercentage += existingDetail.MainChallenge is null ?0:1;
            ProgressPercentage += existingDetail.NextWeekPriority is null ?0:1;
            ProgressPercentage += existingDetail.PlanImplementation is null ?0:1;
            ProgressPercentage += existingDetail.BalanceActivities is null ?0:1;
            ProgressPercentage += existingDetail.MaterialsAvailability is null ?0:1;
            ProgressPercentage += existingDetail.TimeSuitability is null ?0:1;
            ProgressPercentage += existingDetail.RoleDistribution is null ?0:1;
            ProgressPercentage += existingDetail.CurriculumCompliance is null ?0:1;
            ProgressPercentage += existingDetail.UNRWAPrinciplesCompliance is null ?0:1;
            ProgressPercentage += existingDetail.DocumentationQuality is null ?0:1;
            ProgressPercentage += existingDetail.PlanningNotes is null ?0:1;
            ProgressPercentage += existingDetail.AttendanceCommitment is null ?0:1;
            ProgressPercentage += existingDetail.ClassroomManagement is null ?0:1;
            ProgressPercentage += existingDetail.TeachingStrategies is null ?0:1;
            ProgressPercentage += existingDetail.RecreationalStrategies is null ?0:1;
            ProgressPercentage += existingDetail.IndividualDifferences is null ?0:1;
            ProgressPercentage += existingDetail.DisabilityInclusion is null ?0:1;
            ProgressPercentage += existingDetail.FeedbackQuality is null ?0:1;
            ProgressPercentage += existingDetail.TeamworkCoordination is null ?0:1;
            ProgressPercentage += existingDetail.StaffNotes is null ?0:1;
            ProgressPercentage += existingDetail.TrainingNeed is null ?0:1;
            ProgressPercentage += existingDetail.SupportType is null ?0:1; 
            ProgressPercentage += existingDetail.TargetGroup is null ?0:1;
            ProgressPercentage += existingDetail.TrainingResponsible is null ?0:1;
            ProgressPercentage += existingDetail.TrainingDate is null ?0:1;
            ProgressPercentage += existingDetail.AchievementEvidence is null ?0:1;
            ProgressPercentage += existingDetail.WaterSanitationCleanliness is null ?0:1;
            ProgressPercentage += existingDetail.VentilationShadeSeating is null ?0:1;
            ProgressPercentage += existingDetail.FirstAidEmergencyProcedures is null ?0:1;
            ProgressPercentage += existingDetail.ChildProtectionProfessionalConduct is null ?0:1;
            ProgressPercentage += existingDetail.ComplaintReferralMechanism is null ?0:1;
            ProgressPercentage += existingDetail.DisabilityAccessActivities is null ?0:1;
            ProgressPercentage += existingDetail.DignityNonDiscrimination is null ?0:1;
            ProgressPercentage += existingDetail.EnvironmentNotes is null ?0:1;
            ProgressPercentage += existingDetail.RiskChallenge is null ?0:1;
            ProgressPercentage += existingDetail.RiskImpact is null ?0:1;
            ProgressPercentage += existingDetail.RiskProbability is null ?0:1;
            ProgressPercentage += existingDetail.RiskPriority is null ?0:1;
            ProgressPercentage += existingDetail.RiskAction is null ?0:1;
            ProgressPercentage += existingDetail.RiskResponsible is null ?0:1;
            ProgressPercentage += existingDetail.RiskStatus is null ?0:1;
            ProgressPercentage += existingDetail.BestPracticeName is null ?0:1;
            ProgressPercentage += existingDetail.PracticeDescription is null ?0:1;
            ProgressPercentage += existingDetail.SuccessImplementation is null ?0:1;
            ProgressPercentage += existingDetail.ImpactEvidenceData is null ?0:1;
            ProgressPercentage += existingDetail.LessonsLearned is null ?0:1;

        }

        float P = ( (ProgressPercentage / allFieldsCount) * 100);
        return (int) P;
    }

    private void NavigateToDetails(long reportId)
    {
        NavManager.NavigateTo($"{PagesUris.WReportsDetailsPages.Edit}/{WRId}/{reportId}");
    }
    private void NavigateToEdit(long wrd ,long wr)
    {
        NavManager.NavigateTo($"{PagesUris.WReportsDetailsPages.Edit}/{wrd}/{wr}");
    }

}