

@attribute [Route(PagesUris.WReportsDetailsPages.Add)]
@attribute [Route(PagesUris.WReportsDetailsPages.Edit + "/{Id:long}/{wr:long}")]

@using SharedLib.Entities
@using TLSWeb.Pages.WReport.Components


<div class="container my-4" dir="rtl">
    <!-- Header Card -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-primary mb-1">إدخال تفاصيل التقرير الأسبوعي</h3>
                <p class="text-muted mb-0">يرجى تعبئة كافة المراحل المطلوبة بدقة</p>
            </div>
            <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">المرحلة @_currentStep من 7</span>
        </div>
    </div>

    <!-- EditForm Wrapper -->
    <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <!-- Render Current Step Component -->
        <div class="card shadow-sm border-0 rounded-3 p-4 mb-4">
            @switch (_currentStep)
            {
                case 1:
                    <Step1ExecutiveSummary Model="Model" />
                    break;
                case 2:
                    <Step2PlanningQuality Model="Model" />
                    break;
                case 3:
                    <Step3StaffPerformance Model="Model" />
                    break;
                case 4:
                    <Step4TrainingNeeds Model="Model" />
                    break;
                case 5:
                    <Step5Environment Model="Model" />
                    break;
                case 6:
                    <Step6RisksChallenges Model="Model" />
                    break;
                case 7:
                    <Step7BestPractices Model="Model" />
                    break;
            }
        </div>

        <!-- Wizard Navigation Buttons -->
        <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 shadow-sm">
            @if (_currentStep > 1)
            {
                <button type="button" class="btn btn-outline-secondary px-4" @onclick="PreviousStep">
                    <i class="bi bi-arrow-right me-1"></i> السابق
                </button>
            }
            else
            {
                <div></div>
            }

            <div>
                <button type="button" class="btn btn-light me-2 text-danger" @onclick="Cancel">إلغاء</button>
                
                @if (_currentStep < 7)
                {
                    <button type="button" class="btn btn-primary px-4" @onclick="NextStep">
                        حفظ ومتابعة <i class="bi bi-arrow-left ms-1"></i>
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-success px-5">
                        <i class="bi bi-check-circle me-1"></i> إنهاء وحفظ التقرير
                    </button>
                }
            </div>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public long Id { get; set; }
    [Parameter] public long wr { get; set; }

    private int _currentStep = 1;
    public WReportDetail Model { get; set; } = new WReportDetail();
    private bool EditMode => Id > 0;

    override protected async Task OnInitializedAsync()
    {
        if (Id > 0)
        {
            var response = await WReportDetailsApi.GetById(Id);
            if (response is not null)
            {
                Model = response;
                //EditMode = true;
            }
        }
        else
        {
            Model.WReportId = wr;
            // var response = await WReportDetailsApi.Insert(Model);
            // if (response is not null)
            // {
            //     Id = Model.Id;

            // }
            // EditMode = false;
        }

    }

    private void NextStep()
    {
        if (_currentStep < 7) _currentStep++;
    }

    private void PreviousStep()
    {
        if (_currentStep > 1) _currentStep--;
    }

    private async Task HandleValidSubmit()
    {
        if (Id > 0)
        {
            var response = await WReportDetailsApi.Update(Model);
            if (response.Success)
            {
                NavManager.NavigateTo(PagesUris.WReportsPages.Manage);
            }
        }
        else
        {
            var response = await WReportDetailsApi.Insert(Model);
            if (response.Success)
            {
                NavManager.NavigateTo(PagesUris.WReportsPages.Manage);
            }
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo(PagesUris.WReportsPages.Manage);
    }
}