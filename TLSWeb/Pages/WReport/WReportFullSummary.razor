@code {
    [Parameter] public long WRId { get; set; } = 0;
    private WReport? report;
    private List<WReportDetail>? detailsSummary;
    private List<LookupValue>? LookupValues;
    private List<Center> Centers;
    private bool isLoading = false;
    private List<Manager> ListManagers { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
        if (WRId == 0) return;

        try
        {
            LookupValues = await LookupValueApi.GetAll();
            Centers = await CenterApi.GetAll();
            report = await WReportApi.GetById(WRId);
            var Mng = await EmployeeApi.GetAllManagers();

            ListManagers = Mng.SelectMany(x => x.EmpCenters ?? Enumerable.Empty<EmpCenter>(),
                                (manager, center) => new Manager
                                {
                                    ManagerName = manager.Name,
                                    CenterId = center.CenterId
                                })
                   .ToList();
            await LoadDetails(0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reports: {ex.Message}");
        }
    }


    private async Task LoadDetails(long wReportId)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            detailsSummary = report?.WReportDetails.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading full details: {ex.Message}");
            detailsSummary = new List<WReportDetail>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private class Manager
    {
        public string ManagerName { get; set; } = string.Empty;
        public long? CenterId { get; set; } = 0;
    }

    private async Task NavToDetails(long detailsId , long WrID)
    {
       // NavManager.NavigateTo(PagesUris.WReportsDetailsPages.Edit + "/" + detailsId + "/" + WrID.ToString());
        var url = $"{PagesUris.WReportsDetailsPages.Edit}/{detailsId}/{WrID}";
        await JSRuntime.InvokeVoidAsync("eval", $"window.open('{url}', '_blank')");
    }
