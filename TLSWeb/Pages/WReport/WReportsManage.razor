@attribute [Route(PagesUris.WReportsPages.Manage)]

@using SharedLib.Entities
@using TLSWeb.Components

<div class="container my-4" dir="rtl">
    <!-- Header & Action Button -->
    <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-primary mb-1">📋  مجموعات التقارير الأسبوعية</h3>
                <p class="text-muted mb-0">إدارة وعرض مجموعات التقرير الأسبوعي </p>
            </div>
            <AuthorizeView Roles="@AppRoles.Admin">
                <button class="btn btn-primary px-4 py-2" @onclick="OpenCreateModal">
                    <i class="bi bi-plus-lg me-1"></i> إضافة تقرير جديد
                </button>
            </AuthorizeView>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            @if (reports == null)
            {
                <div class="text-center my-5 py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">جاري التحميل...</span>
                    </div>
                    <p class="mt-2 text-muted">جاري تحميل التقارير...</p>
                </div>
            }
            else if (!reports.Any())
            {
                <div class="text-center my-5 py-5">
                    <i class="bi bi-inbox text-muted display-4"></i>
                    <p class="mt-3 text-muted fw-bold">لا توجد تقارير أسبوعية مضافة حتى الآن.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>رقم التقرير</th>
                                <th>تاريخ البداية</th>
                                <th>تاريخ النهاية</th>
                                <th>الملاحظات</th>
                                <th class="text-center">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in reports)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Id</td>
                                    <td>
                                        <span class="badge bg-info text-dark">تقرير رقم @item.WReportNo</span>
                                    </td>
                                    <td>@item.WReportBegin?.ToString("yyyy-MM-dd")</td>
                                    <td>@item.WReportEnd?.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <span class="text-truncate d-inline-block" style="max-width: 250px;">
                                            @(string.IsNullOrEmpty(item.Comments) ? "-" : item.Comments)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- View -->
                                            @* <button class="btn btn-sm btn-outline-info" title="عرض" @onclick="() => OpenViewModal(item)">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            &nbsp;&nbsp; *@
                                            
                                            <AuthorizeView Roles="@AppRoles.User">
                                            <!-- Manage Details Component -->
                                                <button class="btn btn-sm btn-outline-primary" title="إدخال تفاصيل الأنشطة" @onclick="() => NavigateToEdit(item.WReportDetails?.FirstOrDefault()?.Id ??0,item.Id)">
                                                <i class="bi bi-list-check"></i> التفاصيل
                                            </button>
                                            &nbsp;&nbsp;
                                            </AuthorizeView>

                                            <AuthorizeView Roles="@AppRoles.Admin">
                                                <!-- Edit -->
                                                <button class="btn btn-sm btn-outline-warning" title="تعديل" @onclick="() => OpenEditModal(item)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                &nbsp;&nbsp;
                                                <!-- Delete -->
                                                <button class="btn btn-sm btn-outline-danger" title="حذف" @onclick="() => DeleteReport(item.Id)">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                                &nbsp;&nbsp;
                                                <button class="btn btn-sm btn-outline-primary" title="إدخال تفاصيل الأنشطة" @onclick="() => NavigateToDetails(item.Id)">
                                                    <i class="bi bi-list-check"></i> عرض تقارير المراكز
                                                </button>

                                            </AuthorizeView>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Dynamic Modal (Create / Edit / View) -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" dir="rtl">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        @if (modalMode == ModalMode.Create) { <span>إضافة تقرير جديد</span> }
                        else if (modalMode == ModalMode.Edit) { <span>تعديل التقرير #@activeReport.Id</span> }
                        else { <span>تفاصيل التقرير #@activeReport.Id</span> }
                    </h5>
                    <button type="button" class="btn-close ms-0 me-auto" @onclick="CloseModal"></button>
                </div>
                
                <EditForm Model="activeReport" OnValidSubmit="SaveReport">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم التقرير الأسبوعي</label>
                            <InputNumber @bind-Value="activeReport.WReportNo" class="form-control" disabled="@(modalMode == ModalMode.View)" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">تاريخ البداية</label>
                                <InputDate @bind-Value="activeReport.WReportBegin" class="form-control" disabled="@(modalMode == ModalMode.View)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">تاريخ النهاية</label>
                                <InputDate @bind-Value="activeReport.WReportEnd" class="form-control" disabled="@(modalMode == ModalMode.View)" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">ملاحظات</label>
                            <InputTextArea @bind-Value="activeReport.Comments" class="form-control" rows="3" disabled="@(modalMode == ModalMode.View)" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">إغلاق</button>
                        @if (modalMode != ModalMode.View)
                        {
                            <button type="submit" class="btn btn-primary px-4">
                                @(modalMode == ModalMode.Create ? "حفظ" : "تحديث")
                            </button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<DialogMsg IsOpen="@isDeleteDialogOpen" Title="تأكيد الحذف" Message="@dialogMessage"   
OnConfirmed="ConfirmDeleteDialog" OnCancel="CancelDeleteDialog" DialogType="danger"
Icon="bi-exclamation-triangle" />


@code {
    private List<WReport>? reports;
    private WReport activeReport = new();
    private bool isModalOpen = false;
    private ModalMode modalMode = ModalMode.Create;

    bool isDialogOpen = false;
    bool isDeleteDialogOpen = false;
    string dialogMessage = "هل أنت متأكد من حذف التقرير الأسبوعي ؟";
    long reportIdToDelete = 0;


    private enum ModalMode { Create, Edit, View }

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        try
        {
            reports = await WReportApi.GetAll();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reports: {ex.Message}");
            reports = new List<WReport>();
        }
    }

    private void OpenCreateModal()
    {
        activeReport = new WReport { WReportBegin = DateTime.Today, WReportEnd = DateTime.Today.AddDays(7) };
        modalMode = ModalMode.Create;
        isModalOpen = true;
    }

    private void OpenEditModal(WReport report)
    {
        // نعمل نسج كائن جديد لتفادي التعديل المباشر في الجدول قبل الحفظ
        activeReport = new WReport
        {
            Id = report.Id,
            WReportNo = report.WReportNo,
            WReportBegin = report.WReportBegin,
            WReportEnd = report.WReportEnd,
            Comments = report.Comments
        };
        modalMode = ModalMode.Edit;
        isModalOpen = true;
    }

    private void OpenViewModal(WReport report)
    {
        activeReport = report;
        modalMode = ModalMode.View;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task SaveReport()
    {
        if (modalMode == ModalMode.Create)
        {
            // var response = await Http.PostAsJsonAsync("api/WReports", activeReport);
            var response = await WReportApi.Insert(activeReport);
            if (response.Success)
            {
                await LoadReports();
                CloseModal();
            }
        }
        else if (modalMode == ModalMode.Edit)
        {
            // var response = await Http.PutAsJsonAsync($"api/WReports/{activeReport.Id}", activeReport);
            var response = await WReportApi.Update(activeReport);
            if (response.Success)
            {
                await LoadReports();
                CloseModal();
            }
        }
    }

    private async Task DeleteReport(long id)
    {
        reportIdToDelete = id;
        isDeleteDialogOpen = true;
        StateHasChanged();
        return;
    }

    
    private void CancelDeleteDialog()
    {
        isDeleteDialogOpen = false;
        StateHasChanged();
    }

    private async Task ConfirmDeleteDialog()
    {
        var response = await WReportApi.DeleteById(reportIdToDelete);
        isDeleteDialogOpen = false;
        if (response.Success)
        {
            //NavManager.NavigateTo(PagesUris.StudentsPages.Manage);
            MudSnackbar.Add(response.Message, Severity.Success);
            await LoadReports();
        }
        else MudSnackbar.Add(response.Message, Severity.Error);
    }

    private void NavigateToDetails(long reportId)
    {
        NavManager.NavigateTo($"{PagesUris.WReportsPages.CentersManage}/{reportId}");
    }
    private void NavigateToEdit(long wrd ,long wr)
    {
        NavManager.NavigateTo($"{PagesUris.WReportsDetailsPages.Edit}/{wrd}/{wr}");
    }

}