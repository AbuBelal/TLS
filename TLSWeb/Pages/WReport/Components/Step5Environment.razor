@using SharedLib.Entities

<div class="row g-3">
    <div class="col-12 mb-2">
        <h4 class="fw-bold text-dark">البيئة المدرسية</h4>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">المياه ومرافق الصرف الصحي والنظافة <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.WaterSanitationCleanliness" class="form-select">
            <option value="">اختر...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure)
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">التهوية والظل وأماكن الجلوس <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.VentilationShadeSeating" class="form-select">
            <option value="">اختر...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure)
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">توفر الإسعافات الأولية وإجراءات الطوارئ <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.FirstAidEmergencyProcedures" class="form-select">
            <option value="">اختر...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure)
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">تطبيق مبادئ حماية الطفل والسلوك المهني <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.ChildProtectionProfessionalConduct" class="form-select">
            <option value="">اختر...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure)
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">وجود آلية آمنة للشكاوى والإحالة <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.ComplaintReferralMechanism" class="form-select">
            <option value="">اختر...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure)
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">إتاحة الأنشطة للطلبة ذوي الإعاقة <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.DisabilityAccessActivities" class="form-select">
            <option value="">اختر...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure)
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">خصوصية وكرامة الطلبة وعدم التمييز <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.DignityNonDiscrimination" class="form-select">
            <option value="">اختر...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure)
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">📝 ملاحظات إضافية</label>
        <InputTextArea @bind-Value="Model.EnvironmentNotes" class="form-control" rows="3" placeholder="أضف أي ملاحظات إضافية حول البيئة" />
    </div>
</div>

@code {
    [Parameter] public WReportDetail Model { get; set; } = default!;
    List<LookupValue> Mesure;
    protected override async Task OnParametersSetAsync()
    {
        Mesure = await LookupValueApi.GetByValueType(LookupTypes.Mesure2);
        Mesure = Mesure.OrderBy(x => x.SortOrder).ToList();
    }
}