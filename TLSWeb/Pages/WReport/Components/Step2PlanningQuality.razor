@using SharedLib.Entities

<div class="row g-3">
    <div class="col-12 mb-2">
        <h4 class="fw-bold text-dark">انتظام التنفيذ وجودة التخطيط</h4>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">تنفيذ الخطة الأسبوعية ضمن الجدول المعتمد <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.PlanImplementation" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure.OrderBy(x => x.SortOrder))
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">التوازن بين الأنشطة التعليمية والترفيهية <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.BalanceActivities" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
            @foreach (var item in Mesure.OrderBy(x=>x.SortOrder))
            {
             <option value="@item.Id">@item.Name</option>
            }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">توافر المواد قبل بدء النشاط <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.MaterialsAvailability" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure.OrderBy(x => x.SortOrder))
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">ملاءمة زمن النشاط للفئة العمرية والظروف <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.TimeSuitability" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
            @foreach (var item in Mesure)
            {
                <option value="@item.Id">@item.Name</option>
            }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">توزيع الأدوار بوضوح بين الفريق <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.RoleDistribution" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure.OrderBy(x => x.SortOrder))
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">الالتزام بتنفيذ المواد التعليمية المعتمدة <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.CurriculumCompliance" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure.OrderBy(x => x.SortOrder))
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">الأنشطة لا تتعارض مع مبادئ الأونروا <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.UNRWAPrinciplesCompliance" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure.OrderBy(x => x.SortOrder))
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6">
        <label class="form-label fw-bold">توثيق التنفيذ والحضور والنتائج <span class="text-danger">*</span></label>
        <InputSelect @bind-Value="Model.DocumentationQuality" class="form-select">
            <option value="">اختر التقييم...</option>
            @if (Mesure != null)
                @foreach (var item in Mesure.OrderBy(x => x.SortOrder))
                {
                    <option value="@item.Id">@item.Name</option>
                }
        </InputSelect>
    </div>

    <div class="col-md-6 offset-md-6">
        <label class="form-label fw-bold">📝 ملاحظات إضافية</label>
        <InputTextArea @bind-Value="Model.PlanningNotes" class="form-control" rows="3" placeholder="أضف أي ملاحظات إضافية حول التنفيذ" />
    </div>
</div>

@code {
    [Parameter] public WReportDetail Model { get; set; } = default!;
    List<LookupValue> Mesure;
    protected override async Task OnParametersSetAsync()
    {
        Mesure = await LookupValueApi.GetByValueType(LookupTypes.Mesure);
        Mesure = Mesure.OrderBy(x => x.SortOrder).ToList();
    }
}