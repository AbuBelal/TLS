@attribute [Route(PagesUris.AttendanceRecordPages.Manage)]

@using TLSClientSharedLib.ViewModels
@using TLSWeb.Components
@using TLSWeb.Pages.Attendance.Components

<h3>إدارة دوام المركز - مدير المركز</h3>
<hr />
<!-- شريط أدوات موحد: الفلترة، العمليات، تعميم الإجازات، والتصدير -->
<div class="d-flex flex-nowrap align-items-center gap-2 bg-light p-2 rounded-3 shadow-sm mb-4 border overflow-x-auto" style="min-height: 56px;">

    <!-- 1. حقول السنة والشهر -->
    <div class="d-flex align-items-center gap-1">
        <label class="fw-bold text-muted small mb-0 text-nowrap">السنة:</label>
        <input type="number" class="form-control form-control-sm text-center" style="width: 80px;" @bind="Year" />
    </div>
    <div class="d-flex align-items-center gap-1">
        <label class="fw-bold text-muted small mb-0 ms-1 text-nowrap">الشهر:</label>
        <input type="number" class="form-control form-control-sm text-center" style="width: 60px;" @bind="Month" />
    </div>

    <!-- فاصل بصري -->
    <div class="vr mx-1 text-secondary opacity-25"></div>

    <!-- 2. الأزرار الأساسية -->
    <button class="btn btn-sm btn-primary d-flex align-items-center gap-1 text-nowrap" @onclick="LoadData">
        <i class="bi bi-cloud-download"></i> <span class="d-none d-md-inline">جلب</span>
    </button>
    <button class="btn btn-sm btn-success d-flex align-items-center gap-1 text-nowrap" @onclick="SaveChanges" disabled="@(!EmployeeList.Any())">
        <i class="bi bi-check-circle"></i> <span class="d-none d-md-inline">حفظ</span>
    </button>

    <AuthorizeView Roles="@AppRoles.Admin">
        <!-- فاصل بصري -->
        <div class="vr mx-1 text-secondary opacity-25"></div>

        <!-- 1.5 حقول البحث والفلترة المضافة -->
        <div class="d-flex align-items-center gap-1">
            <label class="fw-bold text-muted small mb-0 ms-1 text-nowrap">الاسم:</label>
            <input type="text" class="form-control form-control-sm" style="width: 140px;" placeholder="بحث بالاسم..." @bind="SearchName" @bind:event="oninput" />
        </div>
        <div class="d-flex align-items-center gap-1">
            <label class="fw-bold text-muted small mb-0 ms-1 text-nowrap">المركز:</label>
            <select class="form-select form-select-sm" style="width: 220px;" @bind="FilterCenter">
                <option value="">-- جميع المراكز --</option>
                @if (AllCenters != null)
                {
                    @foreach (var center in AllCenters)
                    {
                        <option value="@center.Name">@center.Name</option>
                    }
                }
            </select>

        </div>
        <!-- فاصل بصري -->
        <div class="vr mx-1 text-secondary opacity-25"></div>

        <!-- 3. أزرار الإدارة (مجمعة في كتل واحدة لتوفير المساحة) -->
        <div class="btn-group shadow-sm">
            <button class="btn btn-sm btn-info d-flex align-items-center gap-1 text-nowrap ml-1" @onclick="GenerateAttRecord" title="إنشاء / تحديث">
                <i class="bi bi-arrow-repeat"></i> <span class=" d-xl-inline">تحديث اللوائح</span>
            </button>
            <button class="btn btn-sm btn-danger d-flex align-items-center gap-1 text-nowrap ml-1" @onclick="@(() => LockAttRecord(true))" title="إغلاق">
                <i class="bi bi-lock-fill"></i> <span class="d-none d-lg-inline">إغلاق</span>
            </button>
            <button class="btn btn-sm btn-success d-flex align-items-center gap-1 text-nowrap" @onclick="@(() => LockAttRecord(false))" title="فتح">
                <i class="bi bi-unlock-fill"></i> <span class="d-none d-lg-inline">فتح</span>
            </button>
        </div>

        @if (EmployeeList.Any())
        {
            <!-- فاصل بصري -->
            <div class="vr mx-1 text-secondary opacity-25"></div>

            <!-- 4. وحدة تعميم الإجازة (Widget مضغوط) -->
            <div class="input-group input-group-sm flex-nowrap shadow-sm" style="width: auto;">
                <span class="input-group-text bg-white text-secondary" title="تعميم إجازة">
                    <i class="bi bi-calendar-event"></i>
                </span>
                <input type="number" class="form-control text-center ml-1" placeholder="يوم" style="min-width: 55px; max-width: 60px;" @bind="DayNoToVac" min="1" max="@DaysInMonth" title="رقم اليوم" />

                @if (LeaveTypes is not null && LeaveTypes.Any())
                {
                    <select class="form-select text-truncate ml-1" style="min-width: 200px; max-width: 150px;" @bind="VacationTypeId" title="نوع الإجازة">
                        <option value="-1">-- النوع --</option>
                        @foreach (var leaveType in LeaveTypes)
                        {
                            <option value="@leaveType.Id">@(leaveType.EnName + " - " + leaveType.Name)</option>
                        }
                    </select>
                }
                <button class="btn btn-warning d-flex align-items-center gap-1 px-2 text-nowrap" @onclick="ApplyVacation" title="تطبيق على الجميع">
                    <i class="bi bi-check2-all"></i> <span class="d-xxl-inline">تطبيق</span>
                </button>
            </div>
        }

        <!-- 5. زر التصدير (يُدفع لأقصى اليسار تلقائياً بفضل ms-auto) -->
        <button class="btn btn-sm btn-white border d-flex align-items-center gap-2 ms-auto bg-white text-nowrap shadow-sm"
                @onclick="Export"
                disabled="@isExporting">
            @if (isExporting)
            {
                <span class="spinner-border spinner-border-sm text-success" role="status" aria-hidden="true"></span>
                <span class="small d-none d-md-inline">تصدير...</span>
            }
            else
            {
                <i class="bi bi-file-earmark-excel-fill text-success fs-6"></i>
                <span class="fw-semibold small d-none d-md-inline">تصدير</span>
            }
        </button>
    </AuthorizeView>
</div>

@if (isLoading)
{
    <LoadingComponent></LoadingComponent>
}
else if (!EmployeeList.Any())
{
    <div class="alert alert-warning d-flex align-items-center shadow-sm rounded-3 p-3 border-0 border-start border-warning border-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-exclamation-triangle-fill ms-3 text-warning" viewBox="0 0 16 16">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
        </svg>
        <div>
            <h6 class="alert-heading mb-1 fw-bold text-dark">لوائح الدوام غير متوفرة</h6>
            <p class="mb-0 text-muted" style="font-size: 0.95rem;">
                عذراً، لوائح الدوام الخاصة بهذا الشهر لم يتم إصدارها بعد. يرجى التواصل مع الإدارة  للمتابعة.
            </p>
        </div>
    </div>
}
else if (!FilteredEmployeeList.Any())
{
    <div class="alert alert-info d-flex align-items-center shadow-sm rounded-3 p-3 border-0 border-start border-info border-4" role="alert">
        <i class="bi bi-search ms-3 fs-3 text-info"></i>
        <div>
            <h6 class="alert-heading mb-1 fw-bold text-dark">لا توجد نتائج</h6>
            <p class="mb-0 text-muted" style="font-size: 0.95rem;">
                لم يتم العثور على موظفين يطابقون معايير البحث والفلترة المدخلة.
            </p>
        </div>
    </div>
}
else
{
    <div class="table-attendance-container shadow-sm">
        <table class="table table-bordered table-hover table-sm text-center  mb-0">
            <thead>
                <tr>
                    <th class="sticky-corner text-white align-content-lg-start" style="min-width: 160px; padding: 12px;">اسم الموظف</th>
                    @for (int i = 1; i <= DaysInMonth; i++)
                    {
                        <th class="sticky-header" style="min-width: 30px;">
                            <span class="d-block" style="font-size: 1.1rem;">@i</span>
                            <span style="font-size: 0.75rem; color: #adb5bd;">
                                @(new DateTime(LoadYear, LoadMonth, i).ToString("ddd", new System.Globalization.CultureInfo("ar-AE")))
                            </span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @{
                    int Serial = 0;
                }
                @foreach (var emp in FilteredEmployeeList) // <--- تم تغيير اللوب ليعتمد على القائمة المفلترة
                {
                    ++Serial;
                    <tr>
                        <td class="sticky-col bg-white px-3 py-2 align-middle">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex flex-column justify-content-center overflow-hidden position-relative">
                                    <div class="position-absolute fw-bold"
                                         style="font-size: 3rem; color: rgba(200,0,0,0.2); right: 5px; top: 50%; transform: translateY(-50%); z-index: 0; pointer-events: none; user-select: none;">
                                        @Serial
                                    </div>
                                    <div class="position-relative" style="z-index: 1;">
                                        <div class="fw-bold text-dark text-truncate mb-1" style="max-width: 130px; font-size: 0.9rem;" title="@emp.EmployeeName">
                                            @emp.EmployeeName
                                        </div>
                                        @if (!string.IsNullOrEmpty(emp.CenterName))
                                        {
                                            <div class="text-muted d-flex align-items-center" style="font-size: 0.75rem;">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" class="bi bi-geo-alt-fill me-1 flex-shrink-0" viewBox="0 0 16 16">
                                                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
                                                </svg>
                                                <span class="text-truncate" style="max-width: 120px;" title="@emp.CenterName">
                                                    @emp.CenterName
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex flex-column position-relative flex-shrink-0" style="z-index: 10;">
                                    <AuthorizeView Roles="@AppRoles.Admin">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger border-0 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 p-0"
                                                style="width: 20px; height: 20px; background-color: #f8f9fa;"
                                                title="حذف"
                                                @onclick="() => DeleteFromAttRec(emp)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                                                <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                                            </svg>
                                        </button>
                                    </AuthorizeView>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary border-0 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 p-0"
                                            style="width: 20px; height: 20px; background-color: #f8f9fa;"
                                            title="تكرار اليوم الأول على جميع أيام الشهر"
                                            @onclick="() => CopyFirstDayToAll(emp)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" class="bi bi-chevron-double-left" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M8.354 1.646a.5.5 0 0 1 0 .708L2.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" />
                                            <path fill-rule="evenodd" d="M12.354 1.646a.5.5 0 0 1 0 .708L6.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </td>
                        @foreach (var day in emp.Days)
                        {
                            <DayCell Day="day"
                                     EmployeeId="emp.EmployeeId"
                                     IsFriday="_fridayDays.Contains(day.DayNumber)"
                                     LeaveTypesDict="_leaveTypesDict"
                                     LeaveTypesList="LeaveTypes" />
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- (باقي كود الـ HTML الخاص بدليل الإجازات والديالوج يبقى كما هو) -->
<div>
    @if (LeaveTypes != null && LeaveTypes.Any())
    {
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold text-secondary">
                    <i class="bi bi-list-ul me-2"></i> دليل أنواع الإجازات
                </h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 text-muted fw-semibold"> شرح الإجازة </th>
                            <th class="py-3 text-muted fw-semibold">الرمز (إنجليزي)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="py-3">
                                <span class="badge bg-success text-dark px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.9rem;">
                                    حضور
                                </span>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-light text-dark border px-3 py-2 rounded-pill" style="font-size: 0.9rem;">
                                    X
                                </span>
                            </td>
                        </tr>

                        @foreach (var leaveType in LeaveTypes)
                        {
                            <tr>
                                <td class="py-3">
                                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm" style="font-size: 0.9rem;">
                                        @leaveType.Name
                                    </span>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill" style="font-size: 0.9rem;">
                                        @leaveType.EnName
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>


<DialogMsg IsOpen="@isDeleteDialogOpen" Title="تأكيد الحذف" Message="@dialogMessage"
           OnConfirmed="ConfirmDeleteDialog" OnCancel="CancelDeleteDialog" DialogType="danger"
           Icon="bi-exclamation-triangle" />

@code {
    private DateTime MonthDayes;
    private int Year = DateTime.Now.Year;
    private int Month = DateTime.Now.Month;
    private bool isExporting = false;
    private long VacationTypeId = -1;
    private int DayNoToVac = 0;

    private int LoadYear = DateTime.Now.Year;
    private int LoadMonth = DateTime.Now.Month;

    private int DaysInMonth = 31;
    private bool isLoading = true;

    // خصائص البحث والفلترة الجديدة
    private string SearchName { get; set; } = string.Empty;
    private string FilterCenter { get; set; } = string.Empty;

    private Dictionary<long, string> _leaveTypesDict;
    private HashSet<int> _fridayDays = new HashSet<int>();

    private List<EmployeeAttendanceVM> EmployeeList = new();
    private List<LookupValue> LeaveTypes = new();
    private List<Center> AllCenters = new();
    // القائمة المفلترة التي سيتم عرضها في الواجهة
    private IEnumerable<EmployeeAttendanceVM> FilteredEmployeeList => EmployeeList.Where(e =>
        (string.IsNullOrWhiteSpace(SearchName) || (e.EmployeeName != null && e.EmployeeName.Contains(SearchName, StringComparison.OrdinalIgnoreCase))) &&
        (string.IsNullOrWhiteSpace(FilterCenter) || (e.CenterName != null && e.CenterName.Contains(FilterCenter, StringComparison.OrdinalIgnoreCase)))
    );

    bool isDialogOpen = false;
    bool isDeleteDialogOpen = false;
    string dialogMessage = "هل أنت متأكد ؟";
    private EmployeeAttendanceVM EmployeToDelete;

    protected override async Task OnInitializedAsync()
    {
        AllCenters = await CenterApi.GetAll();
        await LoadData();
        LeaveTypes = await LookupValueApi.GetByValueType("Vacation");
    }

    private async Task LoadData()
    {
        isLoading = true;
        LoadYear = Year;
        LoadMonth = Month;

        _leaveTypesDict = LeaveTypes.ToDictionary(lt => lt.Id, lt => lt.EnName);
        _fridayDays.Clear();
        int daysInMonth = DateTime.DaysInMonth(LoadYear, LoadMonth);
        for (int i = 1; i <= daysInMonth; i++)
        {
            if (new DateTime(LoadYear, LoadMonth, i).DayOfWeek == DayOfWeek.Friday)
            {
                _fridayDays.Add(i);
            }
        }

        DaysInMonth = DateTime.DaysInMonth(Year, Month);
        MonthDayes = new DateTime(Year, Month, 1);

        var records = await AttendanceRecordApi.GetGeneratedMonthlyAttendance(Year, Month);

        EmployeeList = records.Select(r => MapToViewModel(r, DaysInMonth)).ToList();

        // مسح نصوص البحث عند تحميل بيانات جديدة
        SearchName = string.Empty;
        FilterCenter = string.Empty;

        isLoading = false;
    }

    private async Task SaveChanges()
    {
        isLoading = true;

        // عند الحفظ، نقوم بحفظ كل السجلات وليس فقط المفلترة
        var recordsToUpdate = EmployeeList.Select(e => MapToEntity(e)).ToList();

        var response = await AttendanceRecordApi.Update(recordsToUpdate);
        if (response.Success)
        {
            MudSnackbar.Add("تم حفظ البيانات بنجاح", Severity.Success);
        }

        isLoading = false;
    }

    private async Task GenerateAttRecord()
    {
        isLoading = true;
        GenerateAttendanceRequest request = new GenerateAttendanceRequest
        {
            Year = Year,
            Month = Month,
            HolidayCode = LeaveTypes.FirstOrDefault(lt => lt.EnName == "W")?.Id ?? null,
        };
        var res = await AttendanceRecordApi.GenrateMonthlyAttendance(request);
        if (res.Success)
        {
            await LoadData();
        }
        else
        {
            MudSnackbar.Add("فشلت عملية إنشاء لوائح الدوام !", Severity.Error);
        }
        isLoading = false;
    }

    private async Task LockAttRecord(bool Lock = true)
    {
        isLoading = true;
        GenerateAttendanceRequest request = new GenerateAttendanceRequest
        {
            Year = Year,
            Month = Month,
            Lock = Lock
        };
        var res = await AttendanceRecordApi.LockMonthlyAttendance(request);
        if (res.Success)
        {
            await LoadData();
            MudSnackbar.Add("تم إغلاق لوائح الدوام بنجاح", Severity.Success);
        }
        else
        {
            MudSnackbar.Add("فشلت عملية إغلاق لوائح الدوام !", Severity.Error);
        }
        isLoading = false;
    }

    private async Task ApplyVacation()
    {
        DateTime dayToVac = new DateTime(Year, Month, DayNoToVac);
        if (dayToVac.DayOfWeek == DayOfWeek.Friday)
        {
            MudSnackbar.Add("لا يمكن تعميم يوم إجازة على الموظفين يوم الجمعة ", Severity.Error);
            return;
        }

        // تطبيق الإجازة على القائمة المفلترة فقط إن أردت، أو جميع الموظفين
        // تم استخدام FilteredEmployeeList لتطبيق الإجازة على الموظفين المعروضين فقط
        foreach (var emp in FilteredEmployeeList)
        {
            var day = emp.Days.FirstOrDefault(d => d.DayNumber == DayNoToVac);
            if (day is not null)
            {
                day.IsAttendant = false;
                day.DescId = VacationTypeId;
            }
        }
        MudSnackbar.Add("تم تعميم يوم الإجازة", Severity.Success);
        StateHasChanged();
    }

    private void CopyFirstDayToAll(EmployeeAttendanceVM emp)
    {
        if (emp.Days == null || !emp.Days.Any()) return;

        var firstDay = emp.Days.FirstOrDefault(d => d.DayNumber == 1)
                    ?? emp.Days.OrderBy(d => d.DayNumber).First();

        var targetAttendant = firstDay.IsAttendant;
        var targetDescId = firstDay.DescId;

        foreach (var day in emp.Days)
        {
            if (day.DayNumber != firstDay.DayNumber && !day.IsLocked && !_fridayDays.Contains(day.DayNumber) && day.DescId == null)
            {
                day.IsAttendant = targetAttendant;
                day.DescId = targetDescId;
            }
        }
    }

    private async Task DeleteFromAttRec(EmployeeAttendanceVM Emp)
    {
        EmployeToDelete = Emp;
        dialogMessage = $"هل أنت متأكد من حذف لوائح داوم الموظف / {EmployeToDelete.EmployeeName} من هذا الشهر ؟";
        isDeleteDialogOpen = true;
        return;
    }

    private async Task MoveToCenter(EmployeeAttendanceVM Emp)
    {
        var x = Emp;
    }

    private void CancelDeleteDialog()
    {
        isDeleteDialogOpen = false;
        StateHasChanged();
    }

    private async Task ConfirmDeleteDialog()
    {
        var request = new AttRecoRequest
        {
            Year = Year,
            Month = Month,
            CenterId = EmployeToDelete.OriginalRecord.CenterId,
            EmployeeId = EmployeToDelete.EmployeeId
        };
        var response = await AttendanceRecordApi.DeleteEmpAttRec(request);
        isDeleteDialogOpen = false;
        if (response.Success)
        {
            EmployeeList.RemoveAll(r => r.OriginalRecord.EmployeeId == EmployeToDelete.EmployeeId && r.OriginalRecord.CenterId == EmployeToDelete.OriginalRecord.CenterId);
            StateHasChanged();
            MudSnackbar.Add(response.Message, Severity.Success);
        }
        else MudSnackbar.Add(response.Message, Severity.Error);
    }

    #region Mapper Methods
    private EmployeeAttendanceVM MapToViewModel(AttendanceRecord record, int daysInMonth)
    {
        var vm = new EmployeeAttendanceVM
        {
            EmployeeId = record.EmployeeId,
            EmployeeName = record.Employee?.Name ?? record.Employee?.EnName ?? "غير معروف",
            CenterName = record.Center?.Name ?? "",
            OriginalRecord = record,
        };

        var type = typeof(AttendanceRecord);
        for (int i = 1; i <= daysInMonth; i++)
        {
            var isAttendantProp = type.GetProperty($"Day{i:D2}_IsAttendant");
            var descProp = type.GetProperty($"Day{i:D2}_Desc");

            vm.Days.Add(new DayVM
            {
                DayNumber = i,
                IsAttendant = isAttendantProp?.GetValue(record) as bool?,
                DescId = descProp?.GetValue(record) as long?,
                IsLocked = record.IsLocked ?? false
            });
        }
        return vm;
    }

    private AttendanceRecord MapToEntity(EmployeeAttendanceVM vm)
    {
        var record = vm.OriginalRecord;

        record.Center = null;
        record.Employee = null;
        record.IsLocked = vm.OriginalRecord.IsLocked;
        var type = typeof(AttendanceRecord);

        foreach (var day in vm.Days)
        {
            var isAttendantProp = type.GetProperty($"Day{day.DayNumber:D2}_IsAttendant");
            var descProp = type.GetProperty($"Day{day.DayNumber:D2}_Desc");

            isAttendantProp?.SetValue(record, day.IsAttendant);
            descProp?.SetValue(record, day.DescId);
        }

        return record;
    }
    #endregion

    private async Task Export()
    {
        if (isExporting) return;
        isExporting = true;
        GenerateAttendanceRequest request = new GenerateAttendanceRequest
        {
            Year = Year,
            Month = Month,
        };
        string FileName = $"لوائح داوم شهر {Month}-{Year}.xlsx";
        try
        {
            var response = await AttendanceRecordApi.Export(request);
            if (response.IsSuccessStatusCode)
                await ExcelDownloader.DownloadFromResponse(response, FileName);
            else
                MudSnackbar.Add("فشل تصدير الملف", Severity.Error);
        }
        catch (Exception ex)
        {
            MudSnackbar.Add($"خطأ: {ex.Message}", Severity.Error);
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}